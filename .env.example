# Copy this to .env for local development. Real values (especially in
# production) are set as actual environment variables, never committed.

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/databridge

# Optional: where to POST a notification when a new record is ingested.
# Leave unset to skip webhook delivery entirely.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Signs login JWTs. Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=insecure-local-dev-secret-do-not-use-in-production

# Optional: GitHub OAuth App credentials (Settings > Developer settings >
# OAuth Apps on GitHub). Leave unset to disable "Sign in with GitHub" -
# email+password login still works without them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
