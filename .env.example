# Copy this to .env for local development. Real values (especially in
# production) are set as actual environment variables, never committed.

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/databridge

# Optional: where to POST a notification when a new record is ingested.
# Leave unset to skip webhook delivery entirely.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Signs login JWTs. Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=insecure-local-dev-secret-do-not-use-in-production

# Optional: GitHub OAuth App credentials (Settings > Developer settings >
# OAuth Apps on GitHub). Leave unset to disable "Sign in with GitHub" -
# email+password login still works without them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Resend (resend.dev) API key, used to send forgot-password and
# verify-email emails. Leave unset to skip real delivery - the link is
# logged server-side instead (fine for local dev, never acceptable in
# production). EMAIL_FROM defaults to Resend's shared onboarding@resend.dev
# sender, which needs no custom domain verification BUT only delivers to
# the Resend account's own email address - anyone else's recipient gets a
# silent 403 from Resend until a real domain is verified there. See
# config.py's email_from docstring.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: rejects a /records/upload file larger than this. Defaults to
# 10 if unset.
MAX_UPLOAD_SIZE_MB=10

# Used only by scripts/backup_db.py (the scheduled backup service, not the
# main app). BACKUP_DIR should point at a mounted Railway Volume in
# production - defaults to /data/backups if unset. BACKUP_RETENTION_DAYS
# defaults to 30 if unset.
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30

# Origin of the frontend SPA (frontend/). Used for CORS and as the
# GitHub-OAuth-callback redirect target. Defaults to Vite's dev server
# origin if unset - production sets the real deployed frontend URL.
FRONTEND_URL=http://localhost:5173
