# Copy this to .env for local development. Real values (especially in
# production) are set as actual environment variables, never committed.

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/databridge

# Optional: where to POST a notification when a new record is ingested.
# Leave unset to skip webhook delivery entirely.
WEBHOOK_URL=
WEBHOOK_SECRET=
